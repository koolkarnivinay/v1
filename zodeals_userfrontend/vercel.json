{
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ],
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm install && npm run build"
    }
  }
}
